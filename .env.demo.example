# Get ANON_KEY from: https://app.supabase.com/project/vohkcvivxnkkuwvwtqzm/settings/api
VITE_SUPABASE_URL=https://vohkcvivxnkkuwvwtqzm.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key-here>

# App Environment
VITE_APP_ENV=demo

# Demo Login Credentials (optional - hardcoded in component)
